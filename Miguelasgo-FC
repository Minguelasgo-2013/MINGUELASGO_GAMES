<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Miguelasgo FC</title>
<style>
:root{--bg:#f2f6f1;--card:#fff;--tx:#14231a;--mut:#667a6c;--ac:#14a14a;--ac2:#f5b301;--bd:#d9e4da;--bad:#d64545;color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0d1a12;--card:#16281c;--tx:#e8f3ea;--mut:#8fa896;--ac:#2bd46a;--ac2:#ffc933;--bd:#25402c;--bad:#ff6b6b;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0d1a12;--card:#16281c;--tx:#e8f3ea;--mut:#8fa896;--ac:#2bd46a;--ac2:#ffc933;--bd:#25402c;--bad:#ff6b6b;color-scheme:dark}
*{box-sizing:border-box}html,body{margin:0}
body{background:var(--bg);color:var(--tx);font:15px/1.4 system-ui,-apple-system,"Segoe UI",sans-serif;min-height:100%}
#app{max-width:680px;margin:0 auto;padding:12px}
h1{margin:0;font-size:20px}h2{font-size:16px;margin:14px 0 6px}
.top{display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap}
.chips{display:flex;gap:6px;flex-wrap:wrap;margin:8px 0}
.chip{background:var(--card);border:1px solid var(--bd);border-radius:20px;padding:3px 10px;font-size:13px}
.tabs{display:flex;gap:4px;margin:8px 0;position:sticky;top:0;background:var(--bg);padding:4px 0;z-index:2}
.tabs button{flex:1}
button{font:inherit;background:var(--card);color:var(--tx);border:1px solid var(--bd);border-radius:10px;padding:8px 10px;cursor:pointer}
button.on,button.p{background:var(--ac);color:#04200f;border-color:var(--ac);font-weight:700}
button:disabled{opacity:.4;cursor:default}
.card{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:10px;margin:6px 0}
.r{display:flex;align-items:center;gap:8px;padding:7px 8px;border-radius:8px;cursor:pointer;border:1px solid transparent}
.r:hover{background:var(--bg)}.r.s{border-color:var(--ac2);background:var(--bg)}
.pos{width:36px;font-size:12px;font-weight:700;color:var(--mut)}
.n{flex:1}.ovr{font-weight:800;min-width:28px;text-align:center;border-radius:6px;padding:1px 4px;background:var(--bg)}
.hi{color:var(--ac)}.lo{color:var(--bad)}.mut{color:var(--mut);font-size:13px}
.score{font-size:34px;font-weight:900;text-align:center;letter-spacing:2px}
.log{max-height:300px;overflow:auto;font-size:14px}.log div{padding:3px 0;border-bottom:1px dashed var(--bd)}
.g{color:var(--ac);font-weight:700}.gb{color:var(--bad);font-weight:700}
.row{display:flex;gap:6px;flex-wrap:wrap;align-items:center}.row>*{flex:1}
input{font:inherit;padding:9px;border-radius:10px;border:1px solid var(--bd);background:var(--card);color:var(--tx);width:100%}
.pitch{background:var(--ac);height:6px;border-radius:3px;margin:4px 0}
h1{text-transform:uppercase;font-style:italic;letter-spacing:1px;font-weight:900}
button.on,button.p{color:#fff}.card{border-radius:6px}button{border-radius:6px;text-transform:uppercase;font-size:13px;letter-spacing:.5px}
:root,:root:not([data-theme="light"]),:root[data-theme="dark"]{--bg:#0a0a0c;--card:#16161a;--tx:#f1f1f1;--mut:#8b8b95;--ac:#e5173f;--ac2:#ffc400;--bd:#2a2a31;--bad:#ff7a00;color-scheme:dark}
</style></head><body><div id="app"></div>
<script>
const FN=["Leo","Marc","Iker","Dani","Pablo","Hugo","Alex","Sergio","Raúl","Nico","Adri","Joel","Bruno","Luka","Theo","Dario","Mateo","Ivan","Omar","Kai"];
const LN=["Vega","Torres","Ríos","Costa","Navas","Ferrer","Soler","Pires","Maldini","Okoro","Silva","Duarte","Lobo","Ortiz","Bravo","Ruiz","Kane","Moreno","Sanz","Rey","Cruz","Blanco","Mora","Diop"];
const CL=["Los Cuchillos FC","Atlético Barrizal","Real Pelotazo","Deportivo Tarjeta","Unión Patadón","Racing Chusma","CF Navaja","Sporting Chapuza"];
const FORM={"4-4-2":[4,4,2],"4-3-3":[4,3,3],"3-5-2":[3,5,2],"5-3-2":[5,3,2]};
const $=s=>document.querySelector(s);
const esc=s=>String(s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const clamp=(x,a,b)=>Math.max(a,Math.min(b,x));
const hash=s=>[...String(s)].reduce((a,c)=>(a*31+c.charCodeAt(0))|0,7);
function rng(s){return()=>{s|=0;s=s+0x6D2B79F5|0;let t=Math.imul(s^s>>>15,1|s);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
const slots=f=>["POR",...Array(FORM[f][0]).fill("DEF"),...Array(FORM[f][1]).fill("MED"),...Array(FORM[f][2]).fill("DEL")];
function mkP(r,id,pos,base){const o=clamp(Math.round(base+(r()-.5)*18),42,92);
 return{id,n:FN[Math.floor(r()*FN.length)][0]+". "+LN[Math.floor(r()*LN.length)],pos,ovr:o,v:Math.round(Math.pow(o/50,5)*8)/10}}
function mkSquad(seed,base,tag){const r=rng(seed),L=[];
 ["POR","POR",..."DEF,DEF,DEF,DEF,DEF,DEF,MED,MED,MED,MED,MED,MED,DEL,DEL,DEL,DEL".split(",")].forEach((p,i)=>L.push(mkP(r,tag+i,p,base)));return L}
function autoXI(sq,f){const used=new Set();return slots(f).map(s=>{
 let c=sq.filter(p=>!used.has(p.id)&&p.pos===s).sort((a,b)=>b.ovr-a.ovr)[0]||sq.filter(p=>!used.has(p.id)).sort((a,b)=>b.ovr-a.ovr)[0];
 used.add(c.id);return c.id})}
const eff=(p,s)=>p.pos===s?p.ovr:p.ovr-(s==="POR"||p.pos==="POR"?35:12);
function parts(t){const sl=slots(t.form),g={POR:[],DEF:[],MED:[],DEL:[]};
 t.xi.forEach((id,i)=>{const p=t.squad.find(x=>x.id===id);if(p)g[sl[i]].push({p,e:eff(p,sl[i])})});
 const av=a=>a.length?a.reduce((s,x)=>s+x.e,0)/a.length:30;
 return{g,gk:av(g.POR),def:av(g.DEF),mid:av(g.MED),att:av(g.DEL)}}
const ovrT=t=>{const q=parts(t);return Math.round((q.gk+q.def*4+q.mid*3+q.att*3)/11)};
let db=null,uid=null,S=null,tab="club",sel=null,M=null,peers=[],feed=[];
const cpuTeams=()=>[0,1,2].map(i=>{const b=clamp(54+S.round*1.3+i*7,50,84),sq=mkSquad(S.seed+S.round*31+i,b,"c"+i),f=["4-4-2","4-3-3","3-5-2"][i];
 return{name:CL[(S.round+i*3)%CL.length],squad:sq,form:f,xi:autoXI(sq,f),prize:2+i*2.5,lab:["Fácil","Medio","Difícil"][i]}});
const market=()=>{const r=rng(S.seed+S.round*977),L=[];
 for(let i=0;i<10;i++){L.push(mkP(r,"m"+S.round+"-"+i,["POR","DEF","DEF","MED","MED","DEL","DEL","MED","DEF","DEL"][i],62+Math.min(S.round,10)))}return L.filter(p=>!S.squad.some(x=>x.id===p.id))};
function newState(name){const seed=hash(name+(uid||Math.random()));const sq=mkSquad(seed,62,"p");
 return{name,seed,squad:sq,form:"4-4-2",xi:autoXI(sq,"4-4-2"),budget:30,pts:0,w:0,d:0,l:0,gf:0,ga:0,round:0,streak:0}}
async function save(){try{localStorage.setItem("gaffer",JSON.stringify(S))}catch(e){}
 if(db&&uid&&S){try{await db.doc("managers/"+uid).set({name:S.name,pts:S.pts,w:S.w,d:S.d,l:S.l,gf:S.gf,ga:S.ga,ovr:ovrT(S),st:JSON.stringify(S),t:Date.now()})}catch(e){}}}
const pick=a=>a[Math.floor(Math.random()*a.length)];
function simulate(A,B){const a=parts(A),b=parts(B),T=[a,b],ev=[];let sc=[0,0];
 const scorer=(q,side)=>{const L=[...q.g.DEL.flatMap(x=>[x,x,x,x]),...q.g.MED.flatMap(x=>[x,x]),...q.g.DEF];return pick(L).p};
 for(let m=1;m<=90;m++){
  if(Math.random()<.2){const w=Math.pow(a.mid,3)/(Math.pow(a.mid,3)+Math.pow(b.mid,3)),s=Math.random()<w?0:1,q=T[s],o=T[1-s];
   if(Math.random()<clamp(.5*Math.pow(q.att/o.def,2.5),.12,.9)){
    if(Math.random()<clamp(.3*Math.pow(q.att/o.gk,1.5),.08,.6)){const p=scorer(q,s);sc[s]++;ev.push({m,s,g:1,p:p.id,t:"GOL de "+p.n+". "+pick(["Misil a la escuadra, el portero ni lo vio.","Se la clava sin piedad.","Cabezazo de campeón, que se jodan.","Rosca al palo largo. Sentencia.","Lo borra del mapa y la mete."])})}
    else ev.push({m,s,t:pick(["El portero se la come de milagro.","Rozando el poste, casi se cae el estadio.","Larguerazo que retumba.","Despeje a lo bestia bajo palos."])})}
   else if(Math.random()<.3)ev.push({m,s,t:pick(["Entrada criminal, el árbitro mira para otro lado.","Falta dura en la frontal, se calienta el partido.","Barullo en el área y nadie la empuja.","Tarjeta amarilla por una patada de las feas."])})}
  ev.push({m,x:1,sc:[...sc]})}
 return{ev:ev.filter(e=>!e.x||e.m%1===0),sc}}
function play(opp){const r=simulate(S,opp);M={opp,ev:r.ev.filter(e=>!e.x),sc:r.sc,min:0,hg:0,ag:0,log:[],done:false,iv:null};
 M.iv=setInterval(()=>tick(),130);render()}
function tick(){if(!M)return;M.min++;M.ev.filter(e=>e.m===M.min).forEach(e=>{if(e.g){e.s?M.ag++:M.hg++}M.log.unshift({m:e.m,t:e.t,s:e.s,g:e.g})});
 if(M.min>=90)finish();render()}
function skip(){while(M&&M.min<90){M.min++;M.ev.filter(e=>e.m===M.min).forEach(e=>{if(e.g){e.s?M.ag++:M.hg++}M.log.unshift({m:e.m,t:e.t,s:e.s,g:e.g})})}finish();render()}
function finish(){if(M.done)return;clearInterval(M.iv);M.done=true;const h=M.hg,a=M.ag;
 S.gf+=h;S.ga+=a;S.round++;let res;
 if(h>a){S.w++;S.pts+=3;S.streak++;S.budget+=M.opp.prize||3;res="PALIZA. Esto es Miguelasgo."}else if(h===a){S.d++;S.pts++;S.budget+=1;S.streak=0;res="Empate. Sabe a poco."}else{S.l++;S.streak=0;res="Derrota. Hoy toca tragársela."}
 const best={};M.ev.filter(e=>e.g&&!e.s).forEach(e=>best[e.p]=(best[e.p]||0)+1);
 const mv=Object.entries(best).sort((x,y)=>y[1]-x[1])[0];let up="";
 if(mv){const p=S.squad.find(x=>x.id===mv[0]);if(p&&p.ovr<95){p.ovr++;p.v=Math.round(Math.pow(p.ovr/50,5)*8)/10;up=" · "+esc(p.n)+" sube a "+p.ovr}}
 M.res=res+up;S.budget=Math.round(S.budget*10)/10;save();
 if(db&&M.opp.online){db.collection("results").add({a:S.name,b:M.opp.name,ga:h,gb:a,t:Date.now()}).catch(()=>{})}}
function ovc(o){return o>=75?"hi":o<55?"lo":""}
function row(p,s,i){const bad=s&&p.pos!==s;return`<div class="r${sel===p.id?" s":""}" data-a="pick" data-id="${p.id}"><span class="pos">${s||p.pos}</span><span class="n">${esc(p.n)} ${bad?'<span class="lo">⚠ '+p.pos+"</span>":""}</span><span class="ovr ${ovc(p.ovr)}">${p.ovr}</span></div>`}
function vClub(){const sl=slots(S.form),bench=S.squad.filter(p=>!S.xi.includes(p.id));
 return`<div class="row">${Object.keys(FORM).map(f=>`<button class="${S.form===f?"on":""}" data-a="form" data-f="${f}">${f}</button>`).join("")}</div>
 <h2>Once inicial · media ${ovrT(S)}</h2><div class="card">${S.xi.map((id,i)=>row(S.squad.find(p=>p.id===id),sl[i])).join("")}</div>
 <h2>Banquillo (${bench.length})</h2><div class="mut">Toca un titular y luego un suplente para cambiarlos.</div><div class="card">${bench.map(p=>`<div class="r${sel===p.id?" s":""}" data-a="pick" data-id="${p.id}"><span class="pos">${p.pos}</span><span class="n">${esc(p.n)}</span><span class="ovr ${ovc(p.ovr)}">${p.ovr}</span><button data-a="sell" data-id="${p.id}">Vender ${(p.v*.7).toFixed(1)}M</button></div>`).join("")}</div>
 <button data-a="auto" style="width:100%">Alineación automática</button>`}
function vMarket(){return`<h2>Mercado · jornada ${S.round+1}</h2><div class="mut">Se renueva tras cada partido. Plantilla ${S.squad.length}/24.</div>`+market().map(p=>`<div class="card r" style="cursor:default"><span class="pos">${p.pos}</span><span class="n">${esc(p.n)}</span><span class="ovr ${ovc(p.ovr)}">${p.ovr}</span><button class="p" data-a="buy" data-id="${p.id}" ${S.budget<p.v||S.squad.length>=24?"disabled":""}>${p.v.toFixed(1)}M</button></div>`).join("")}
function vPlay(){const c=cpuTeams(),on=peers.filter(p=>p.id!==uid);
 return`<h2>Liga CPU · jornada ${S.round+1}</h2>`+c.map((t,i)=>`<div class="card row"><div class="n"><b>${esc(t.name)}</b><div class="mut">${t.lab} · media ${ovrT(t)} · premio ${t.prize}M</div></div><button class="p" data-a="cpu" data-i="${i}" style="flex:0 0 auto">Jugar</button></div>`).join("")
 +`<h2>Retos online: a por ellos</h2>`+(db?(on.length?on.map(p=>`<div class="card row"><div class="n"><b>${esc(p.d.name)}</b><div class="mut">media ${p.d.ovr} · ${p.d.pts} pts</div></div><button class="p" data-a="on" data-id="${p.id}" style="flex:0 0 auto">Machacar</button></div>`).join(""):'<div class="mut">Aún no hay otros managers. ¡Comparte el enlace!</div>'):'<div class="mut">Modo online no disponible en esta vista. Comparte el enlace con permiso de colaborar para jugar contra amigos.</div>')}
function vLeague(){const L=[...peers].sort((a,b)=>b.d.pts-a.d.pts||(b.d.gf-b.d.ga)-(a.d.gf-a.d.ga));
 return`<h2>Clasificación online</h2><div class="card">`+(L.length?L.map((p,i)=>`<div class="r" style="cursor:default"><span class="pos">${i+1}º</span><span class="n">${esc(p.d.name)}${p.id===uid?" (tú)":""}</span><span class="mut">${p.d.w}-${p.d.d}-${p.d.l}</span><b>${p.d.pts}</b></div>`).join(""):'<div class="mut">Sin datos online todavía.</div>')+`</div><h2>Últimos partidos</h2><div class="card">`+(feed.length?feed.map(f=>`<div class="mut">${esc(f.a)} <b>${f.ga}-${f.gb}</b> ${esc(f.b)}</div>`).join(""):'<div class="mut">Nada aún.</div>')+"</div>"}
function vMatch(){return`<div class="card"><div class="mut" style="text-align:center">${esc(S.name)} vs ${esc(M.opp.name)} · min ${Math.min(M.min,90)}'</div><div class="score">${M.hg} - ${M.ag}</div><div class="pitch" style="width:${M.min/.9}%"></div></div>
 ${M.done?`<div class="card" style="text-align:center"><b>${M.res}</b></div><button class="p" style="width:100%" data-a="close">Continuar</button>`:`<button style="width:100%" data-a="skip">Saltar ⏩</button>`}
 <div class="card log">${M.log.map(l=>`<div class="${l.g?(l.s?"gb":"g"):""}">${l.m}' ${esc(l.t)}</div>`).join("")||'<div class="mut">Pitido inicial…</div>'}</div>`}
function render(){const el=$("#app");if(!S){el.innerHTML=`<h1>Miguelasgo FC</h1><div class="card"><p>Aquí no se viene a hacer amigos. Ficha, alinea y aplasta a los demás managers.</p><input id="nm" maxlength="22" value="Miguelasgo FC" placeholder="Nombre de tu club"><br><br><button class="p" data-a="start" style="width:100%">Empezar</button></div>`;return}
 let b;if(M)b=vMatch();else b={club:vClub,market:vMarket,play:vPlay,league:vLeague}[tab]();
 el.innerHTML=`<div class="top"><h1>${esc(S.name)}</h1><span class="mut">${db?"🟢 online":"⚪ solo"}</span></div>
 <div class="chips"><span class="chip">💰 ${S.budget.toFixed(1)}M</span><span class="chip">${S.pts} pts</span><span class="chip">${S.w}V ${S.d}E ${S.l}D</span><span class="chip">racha ${S.streak}</span><span class="chip">Media ${ovrT(S)}</span></div>
 ${M?"":`<div class="tabs">${[["club","Club"],["market","Mercado"],["play","Jugar"],["league","Liga"]].map(([k,l])=>`<button class="${tab===k?"on":""}" data-a="tab" data-k="${k}">${l}</button>`).join("")}</div>`}${b}`}
document.addEventListener("click",e=>{const t=e.target.closest("[data-a]");if(!t)return;e.stopPropagation();const a=t.dataset.a,id=t.dataset.id;
 if(a==="start"){const n=$("#nm").value.trim()||"Miguelasgo FC";S=newState(n);save()}
 else if(a==="tab"){tab=t.dataset.k;sel=null}
 else if(a==="form"){S.form=t.dataset.f;S.xi=autoXI(S.squad,S.form);sel=null;save()}
 else if(a==="auto"){S.xi=autoXI(S.squad,S.form);sel=null;save()}
 else if(a==="pick"){if(!sel)sel=id;else if(sel===id)sel=null;else{const i=S.xi.indexOf(sel),j=S.xi.indexOf(id);
   if(i>=0&&j>=0){[S.xi[i],S.xi[j]]=[S.xi[j],S.xi[i]]}else if(i>=0)S.xi[i]=id;else if(j>=0)S.xi[j]=sel;sel=null;save()}}
 else if(a==="sell"){const p=S.squad.find(x=>x.id===id);if(S.squad.length>16){S.budget=Math.round((S.budget+p.v*.7)*10)/10;S.squad=S.squad.filter(x=>x.id!==id);save()}}
 else if(a==="buy"){const p=market().find(x=>x.id===id);if(p&&S.budget>=p.v){S.budget=Math.round((S.budget-p.v)*10)/10;S.squad.push(p);save()}}
 else if(a==="cpu"){play(cpuTeams()[+t.dataset.i]);return}
 else if(a==="on"){const p=peers.find(x=>x.id===id);try{const o=JSON.parse(p.d.st);play({name:o.name,squad:o.squad,xi:o.xi,form:o.form,online:1,prize:3});return}catch(x){}}
 else if(a==="skip"){skip();return}
 else if(a==="close"){M=null;tab="club"}
 render()});
(async()=>{let ls=null;try{ls=JSON.parse(localStorage.getItem("gaffer"))}catch(e){}S=ls;render();
 try{if(window.claude){const u=await claude.use("user");uid=u?await u.id():null;db=uid?await claude.use("db"):null}}catch(e){}
 if(db){try{const d=await db.doc("managers/"+uid).get();if(d.exists&&d.data().st)S=JSON.parse(d.data().st)}catch(e){}
  try{db.collection("managers").onSnapshot(s=>{peers=s.docs.map(x=>({id:x.id,d:x.data()}));if(!M)render()})}catch(e){}
  try{db.collection("results").limit(40).onSnapshot(s=>{feed=s.docs.map(x=>x.data()).sort((a,b)=>b.t-a.t).slice(0,8);if(!M&&tab==="league")render()})}catch(e){}}
 render()})();
</script></body></html>
